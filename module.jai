load_image_16_from_memory :: (data: [] u8, desired_channels := Channel.default) -> Image_16, bool {
    assert(data.count <= 0x7fffffff, "Image `data.count` is too large for `stb_image`");
    width, height, file_channels: s32;

    pixels := stbi_load_16_from_memory(data.data, cast(s32) data.count, *width, *height, *file_channels, cast(s32) desired_channels);
    if pixels == null return Image_16.{}, false;
    channels := file_channels;
    if desired_channels != .default channels = cast(s32) desired_channels;
    count := cast(s64) width * cast(s64) height * cast(s64) channels;

    return Image_16.{
        pixels = ([] u16).{ count, pixels },
        width = width,
        height = height,
        channels = channels,
        file_channels = file_channels,
    }, true;
