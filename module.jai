    c_path := to_c_string(path);
    defer free(c_path);

    width, height, file_channels: s32;

    pixels := stbi_load_16(c_path, *width, *height, *file_channels, cast(s32) desired_channels);
    if pixels == null return Image_16.{}, false;
    channels := file_channels;
    if desired_channels != .default channels = cast(s32) desired_channels;
    count := cast(s64) width * cast(s64) height * cast(s64) channels;

    return Image_16.{
        pixels = ([] u16).{ count, pixels },
        width = width,
        height = height,
        channels = channels,
        file_channels = file_channels,
    }, true;
