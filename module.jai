// Raw C bindings live in bindings.jai and are regenerated by `jaic generate.jai`.
// Jai-way wrappers and helpers located in this file.

#load "bindings.jai";

Channel :: enum s32 {
    default :: 0; // keep channel count from file
    grey :: 1;
    grey_alpha :: 2;
    rgb :: 3;
    rgb_alpha :: 4;
}

Image :: struct {
    pixels: [] u8;
    width, height: s32;
    channels: s32; // store channels in `pixels`
    file_channels: s32; // channels in src file
}

Image_16 :: struct {
    pixels: [] u16;
    width, height: s32;
    channels: s32; // store channels in `pixels`
    file_channels: s32; // channels in src file
}

// `LDR` images converted to linear `HDR` data
Image_F32 :: struct {
    pixels: [] float32;
    width, height: s32;
    channels: s32; // store channels in `pixels`
    file_channels: s32; // channels in src file
}

GIF :: struct {
    pixels: [] u8;
    delays: [] s32; // per-frame delay in milliseconds
    width, height: s32;
    frame_count: s32;
    channels: s32; // store channels in `pixels`
    file_channels: s32; // channels in src file
}

Image_Info :: struct {
    width, height: s32;
    file_channels: s32;
}

load_image :: (path: string, desired_channels := Channel.default) -> Image, bool {
    c_path := to_c_string(path);
    defer free(c_path);

    width, height, file_channels: s32;

    pixels := stbi_load(c_path, *width, *height, *file_channels, cast(s32) desired_channels);
    if pixels == null return Image.{}, false;
    channels := file_channels;
    if desired_channels != .default channels = cast(s32) desired_channels;
    count := cast(s64) width * cast(s64) height * cast(s64) channels;

    return Image.{
        pixels = ([] u8).{ count, pixels },
        width = width,
        height = height,
        channels = channels,
        file_channels = file_channels,
    }, true;
}

load_image_from_memory :: (data: [] u8, desired_channels := Channel.default) -> Image, bool {
    assert(data.count <= 0x7fffffff, "Image `data.count` is too large for `stb_image`"); // `0x7fffffff` - is max pos N
    width, height, file_channels: s32;

    pixels := stbi_load_from_memory(data.data, cast(s32) data.count, *width, *height, *file_channels, cast(s32) desired_channels);
    if pixels == null return Image.{}, false;
    channels := file_channels;
    if desired_channels != .default channels = cast(s32) desired_channels;
    count := cast(s64) width * cast(s64) height * cast(s64) channels;

    return Image.{
        pixels = ([] u8).{ count, pixels },
        width = width,
        height = height,
        channels = channels,
        file_channels = file_channels,
    }, true;
}

