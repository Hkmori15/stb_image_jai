load_image_f32 :: (path: string, desired_channels := Channel.default) -> Image_F32, bool {
    c_path := to_c_string(path);
    defer free(c_path);

    width, height, file_channels: s32;

    pixels := stbi_loadf(c_path, *width, *height, *file_channels, cast(s32) desired_channels);
    if pixels == null return Image_F32.{}, false;
    channels := file_channels;
    if desired_channels != .default channels = cast(s32) desired_channels;
    count := cast(s64) width * cast(s64) height * cast(s64) channels;

    return Image_F32.{
        pixels = ([] float32).{ count, pixels },
        width = width,
        height = height,
        channels = channels,
        file_channels = file_channels,
    }, true;
}

load_image_f32_from_memory :: (data: [] u8, desired_channels := Channel.default) -> Image_F32, bool {
    assert(data.count <= 0x7fffffff, "Image `data.count` is too large for `stb_image`");
    width, height, file_channels: s32;

    pixels := stbi_loadf_from_memory(data.data, cast(s32) data.count, *width, *height, *file_channels, cast(s32) desired_channels);
    if pixels == null return Image_F32.{}, false;
    channels := file_channels;
    if desired_channels != .default channels = cast(s32) desired_channels;
    count := cast(s64) width * cast(s64) height * cast(s64) channels;

    return Image_F32.{
        pixels = ([] float32).{ count, pixels },
        width = width,
        height = height,
        channels = channels,
        file_channels = file_channels,
    }, true;
}

load_gif_from_memory :: (data: [] u8, desired_channels := Channel.default) -> GIF, bool {
    assert(data.count <= 0x7fffffff, "Image `data.count` is too large for `stb_image`");
    delays: *s32;
    width, height, frames, file_channels: s32;

    pixels := stbi_load_gif_from_memory(data.data, cast(s32) data.count, *delays, *width, *height, *frames, *file_channels, cast(s32) desired_channels);
    if pixels == null return GIF.{}, false;
    assert(delays != null);

    channels := file_channels;
    if desired_channels != .default channels = cast(s32) desired_channels;
    count := cast(s64) width * cast(s64) height * cast(s64) frames * cast(s64) channels;

    return GIF.{
        pixels = ([] u8).{ count, pixels },
        delays = ([] s32).{ frames, delays },
        width = width,
        height = height,
        frame_count = frames,
        channels = channels,
        file_channels = file_channels,
    }, true;
}

get_image_info :: (path: string) -> Image_Info, bool {
    c_path := to_c_string(path);
    defer free(c_path);

    width, height, file_channels: s32;
    if stbi_info(c_path, *width, *height, *file_channels) == 0 return Image_Info.{}, false;

    return Image_Info.{ width = width, height = height, file_channels = file_channels }, true;
}

get_image_info_from_memory :: (data: [] u8) -> Image_Info, bool {
    assert(data.count <= 0x7fffffff, "Image `data.count` is too large for `stb_image`");
    width, height, file_channels: s32;
    if stbi_info_from_memory(data.data, cast(s32) data.count, *width, *height, *file_channels) == 0 return Image_Info.{}, false;

    return Image_Info.{ width = width, height = height, file_channels = file_channels }, true;
}

set_flip_vertically_on_load :: (flip: bool) {
    stbi_set_flip_vertically_on_load(ifx flip then 1 else 0);
}

set_unpremultiply_on_load :: (unpremultiply: bool) {
    stbi_set_unpremultiply_on_load(ifx unpremultiply then 1 else 0);
}

convert_iphone_png_to_rgb :: (convert: bool) {
    stbi_convert_iphone_png_to_rgb(ifx convert then 1 else 0);
}

set_flip_vertically_on_load_thread :: (flip: bool) {
    stbi_set_flip_vertically_on_load_thread(ifx flip then 1 else 0);
}

set_unpremultiply_on_load_thread :: (unpremultiply: bool) {
    stbi_set_unpremultiply_on_load_thread(ifx unpremultiply then 1 else 0);
}

convert_iphone_png_to_rgb_thread :: (convert: bool) {
    stbi_convert_iphone_png_to_rgb_thread(ifx convert then 1 else 0);
}

// Borrowed view of `stb_image` static failure string
// Do NOT free it
failure_reason :: () -> string {
    reason := stbi_failure_reason();
    if reason == null return "";
    count: s64 = 0;
    while reason[count] != 0 count += 1;

    return .{ count, reason };
}

is_hdr :: (path: string) -> bool {
    c_path := to_c_string(path);
    defer free(c_path);

    return stbi_is_hdr(c_path) != 0;
}

is_hdr_from_memory :: (data: [] u8) -> bool {
    assert(data.count <= 0x7fffffff, "Image `data.count` is too large for `stb_image`");

    return stbi_is_hdr_from_memory(data.data, cast(s32) data.count) != 0;
}

is_16_bit :: (path: string) -> bool {
    c_path := to_c_string(path);
    defer free(c_path);

    return stbi_is_16_bit(c_path) != 0;
}

is_16_bit_from_memory :: (data: [] u8) -> bool {
    assert(data.count <= 0x7fffffff, "Image `data.count` is too large for `stb_image`");

    return stbi_is_16_bit_from_memory(data.data, cast(s32) data.count) != 0;
}

free_image :: (image: *$T) {
    #if T == Image {
        if image.pixels.data != null stbi_image_free(image.pixels.data);
        image.* = Image.{};
    } else #if T == Image_16 {
        if image.pixels.data != null stbi_image_free(image.pixels.data);
        image.* = Image_16.{};
    } else #if T == Image_F32 {
        if image.pixels.data != null stbi_image_free(image.pixels.data);
        image.* = Image_F32.{};
    } else #if T == GIF {
        if image.delays.data != null stbi_image_free(image.delays.data);
        if image.pixels.data != null stbi_image_free(image.pixels.data);
        image.* = GIF.{};
    } else {
        #assert false, "`free_image` accept: `Image`, `Image_16`, `Image_F32` or `GIF`";
    }
}

#import "Basic";
